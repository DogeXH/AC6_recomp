+static ac6net::XnAddr SampleXnAddr() {
+  ac6net::XnAddr a;
+  a.ina = 0x0A400007;
+  a.ina_online = 0x0A400007;
+  a.port_online = 1000;
+  a.ab_enet = {0x00, 0x22, 0x48, 0x00, 0x00, 0x07};
+  for (size_t i = 0; i < a.ab_online.size(); ++i) a.ab_online[i] = static_cast<uint8_t>(i + 1);
+  return a;
+}
