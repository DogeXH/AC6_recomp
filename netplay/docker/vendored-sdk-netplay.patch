+
+  GuestBuffer empty(0x61200000, m::kRegistrationResultsSize);
+  auto empty_arena = empty.arena();
+  CHECK(m::LayoutRegistrationResults(empty_arena, {}));
+  CHECK(empty.u32(empty.base) == 0 && empty.u32(empty.base + 4) == 0);
+}
