+int main() {
+  TestBigEndian();
+  TestXnAddrAndSessionInfo();
+  TestArena();
+  TestUserData();
+  TestSearchLayout();
+  TestRegistrationLayout();
+  TestStatsLayout();
+  std::printf("netplay_xam_test: %d checks, %d failures\n", g_checks, g_failures);
+  return g_failures ? 1 : 0;
+}
