# Windows (Proton) netplay test instance @INST@, generated by win-setup.sh from
# netplay/tools/win_deck/ac6recomp-win.toml.in (the Linux test instance D's config, 2026-10-19,
# with every path moved into this instance). The game reads this file from the folder of the
# exe it runs (bin/), so the instance never sees Cole's own config.
# Paths are Windows paths on Wine's Z: drive (Z:/ = the Deck's /). Use forward slashes:
# TOML "..." strings treat a backslash as an escape.


ac6_graphics_backend = "@BACKEND@"
fullscreen = false
window_width = 640
window_height = 360
window_x = @WX@
window_y = @WY@
draw_resolution_scale_x = 1
draw_resolution_scale_y = 1
vsync = true
ac6_native_renderer = true
ac6_native_takeover = true
ac6_native_shared_authority = true
ac6_native_takeover_enable_marker = "Z:@I@/state/ENABLE_NATIVE_TAKEOVER"
ac6_native_takeover_disable_marker = "Z:@I@/state/DISABLE_NATIVE_TAKEOVER"
ac6_native_validate_resolves = false
ac6_native_propagate_unvalidated = true
ac6_native_propagate_after_swaps = 2
ac6_native_resolve_min_oracle_match_percent = 100
ac6_native_resolve_oracle_tolerance = 0
trace_gpu_prefix = "Z:@I@/state"
trace_gpu_capture_marker = "Z:@I@/state/CAPTURE_NEXT_FRAME"
async_shader_compilation = true
vulkan_async_skip_incomplete_frames = true
vulkan_pipeline_creation_threads = 2
vulkan_dynamic_rendering = true
vulkan_submit_on_primary_buffer_end = true
vulkan_max_primary_buffer_ends_without_present = 8
occlusion_query_enable = false
depth_float24_convert_in_pixel_shader = false
depth_float24_round = false
ac6_unlock_fps = true
ac6_dynamic_vblank = true
ac6_performance_mode = true
ac6_terrain_hd = false
ac6_fullres_effects = false
ac6_effect_mode_fix = false
input_backend = "sdl"
mnk_mode = false
audio_backend = "sdl"
audio_deep_trace = false
audio_trace_render_driver_verbose = false
audio_callback_low_water_frames = 4
audio_callback_target_queue_depth = 6
iso_direct = true
game_iso = "Z:/home/deck/Games/ACE6-Recomp/Ace Combat 6 - Fires of Liberation (USA, Japan) (En,Ja).iso"
user_data_root = "Z:@I@/user-data"
dlc_containers = true
dlc_dir = "Z:@WT@/dlc-raw-mac"
license_mask = 4294967295
log_level = "warn"
log_noisy = false
native_2x_msaa = true
audio_pin_sound_thread = false
ac6_fps_target = 60.0
anisotropic_override = 1
ac6_world_msaa_1x = true

# Verified save I/O and visually checked Deck candidate, 2026-09-13.
execute_unclipped_draw_vs_on_cpu = true
ac6_kbm_enabled = false
log_file = "Z:@I@/ac6recomp.log"

# Clear transfer and bounded pacing improvements validated in Mission 1.
# 60 FPS target; sustained headroom and tail latency remain under investigation.
ac6_max_sim_fps = 60.0
vulkan_ac6_rect_clear_lowering = true
vulkan_ac6_clear_discard_transfers = true
present_pacing_preserve_phase = true
ac6_present_max_in_flight = 2

# --- Netplay test instance "@INST@" (Windows exe under Proton). Lobby server runs on Cole's Mac. ---
[netplay]
enabled = true
server = "@SERVER@"
server_key = "@KEY@"
gamertag = "@TAG@"
port = 0
force_relay = false
privacy = false
lan = true
trace = "Z:@I@/trace.jsonl"
input_script = "Z:@I@/repl_script.txt"
screenshot_dir = "Z:@I@/shots"

[log.levels]
netinput = "info"
krnl = "info"
